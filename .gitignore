# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
.turbo/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Java / Spring
target/
.gradle/
build/
*.class

# Coverage / reports
coverage/
htmlcov/
reports/

# Infrastructure
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Local data: raw and generated artifacts are never committed
data/raw/*
!data/raw/**/.gitkeep
data/interim/*
!data/interim/**/.gitkeep
data/processed/*
!data/processed/**/.gitkeep
data/reports/*
!data/reports/.gitkeep
