# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.10.7 AS uv
FROM python:3.13.12-slim-trixie AS builder

COPY --from=uv /uv /uvx /bin/
ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build

COPY packaging/a-labeling/pyproject.toml packaging/a-labeling/uv.lock ./packaging/a-labeling/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project packaging/a-labeling --locked --no-dev --no-install-project
COPY src ./src
COPY config/model1_aliases_reviewed_v2.json ./config/model1_aliases_reviewed_v2.json
COPY config/demand_constraint_rules.json ./config/demand_constraint_rules.json
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project packaging/a-labeling --locked --no-dev --no-editable

FROM python:3.13.12-slim-trixie AS runtime
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    A_WRITE_DATABASE=true \
    A_ALIAS_REGISTRY_PATH=/app/config/model1_aliases_reviewed_v2.json \
    A_RULES_PATH=/app/config/demand_constraint_rules.json

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/config/model1_aliases_reviewed_v2.json ./config/model1_aliases_reviewed_v2.json
COPY --from=builder /build/config/demand_constraint_rules.json ./config/demand_constraint_rules.json

USER 65534:65534
ENTRYPOINT ["a-labeling-batch", "--write-db", "--output", "/tmp/a-labeling-output.csv"]
