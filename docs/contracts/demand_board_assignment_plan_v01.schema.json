{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moongcheap.local/contracts/demand-board-assignment-plan-v0.1.schema.json",
  "title": "Demand Board Assignment Plan v0.1",
  "description": "Minimal mutation DTO. Board lifecycle and state-transition policy are owned by Backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plannedAt",
    "ruleVersion",
    "existingBoardAssignments",
    "newBoards"
  ],
  "properties": {
    "schemaVersion": {"const": "demand-board-assignment-plan.v0.1"},
    "plannedAt": {"type": "string", "format": "date-time"},
    "ruleVersion": {"type": "string", "minLength": 1, "maxLength": 200},
    "existingBoardAssignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/existingBoardAssignment"}
    },
    "newBoards": {
      "type": "array",
      "items": {"$ref": "#/$defs/newBoard"}
    }
  },
  "$defs": {
    "positiveDemandIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "newBoardDemandIds": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "existingBoardAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demandBoardId", "demandIds"],
      "properties": {
        "demandBoardId": {"type": "integer", "minimum": 1},
        "demandIds": {"$ref": "#/$defs/positiveDemandIds"}
      }
    },
    "newBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientBoardKey",
        "catalogId",
        "priceMin",
        "priceMax",
        "demandIds"
      ],
      "properties": {
        "clientBoardKey": {"type": "string", "minLength": 1, "maxLength": 160},
        "catalogId": {"type": "integer", "minimum": 1},
        "priceMin": {"type": "integer", "minimum": 0},
        "priceMax": {"type": "integer", "minimum": 0},
        "demandIds": {"$ref": "#/$defs/newBoardDemandIds"}
      }
    }
  }
}
