MFDS_API_KEY=
FOODPOLIS_API_KEY=
FOODPOLIS_RETAIL_API_URL=
FOODPOLIS_API_KEY_PARAM=opapiAtkeyCn
MFDS_MAX_PAGES=
DEMAND_CATALOG_SEED_PATH=
DEMAND_TAXONOMY_PATH=config/facet_taxonomy_v2_2.json
A_TAXONOMY_PATH=config/facet_taxonomy_v2_2.json
A_ALIAS_REGISTRY_PATH=config/model1_aliases_reviewed_v2.json
# Optional Model 2 fallback. Keep disabled unless Ollama and the Qwen model are provisioned.
A_MODEL2_FALLBACK_ENABLED=false
A_MODEL2_FALLBACK_MODEL=qwen2.5:7b-instruct
A_MODEL2_OLLAMA_BASE_URL=http://localhost:11434
A_MODEL2_FALLBACK_TIMEOUT_SECONDS=300
A_MODEL2_FALLBACK_BATCH_SIZE=5
LABELING_LLM_FALLBACK_ENABLED=false
DEMAND_CONSTRAINT_RULES_PATH=config/demand_constraint_rules.json
# Optional A aliases: blank/missing file uses B only; invalid contents stop startup.
DEMAND_CONSTRAINT_ALIASES_PATH=config/model1_aliases_reviewed_v2.json
# Required B base expressions, always loaded; overlapping A expressions take priority.
DEMAND_CONSTRAINT_COMPAT_ALIASES_PATH=config/demand_constraint_aliases.json
# Part B: an explicit PostgreSQL DSN takes precedence over DB_* below.
SHARED_DATABASE_URL=
# Otherwise Part B builds its DSN from the Backend's existing Secret entries.
# DB_URL accepts jdbc:postgresql://host:port/database (or a native PostgreSQL URL).
DB_URL=
DB_USERNAME=
DB_PASSWORD=
BACKEND_BASE_URL=
# K8s maps backend-env/MOONGCHEAP_INTERNAL_API_KEY to this AI variable.
# Cloud must supply that entry from the shared Parameter Store SecureString.
BACKEND_INTERNAL_KEY=
# Backend -> AI 방향(판매자 수요 분석 API)의 내부 키. 같은 Parameter Store 에서 주입한다.
# 비워 두면 서버가 기동하지 않는다. 인증 없이 띄우려면 아래를 1 로 명시한다.
SELLER_ANALYSIS_INTERNAL_KEY=
SELLER_ANALYSIS_ALLOW_UNAUTHENTICATED=
BACKEND_HTTP_TIMEOUT_SECONDS=15
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
CLUSTER_MIN_PARTICIPANTS=5
E5_MODEL_PATH=
E5_MODEL_REVISION=
E5_BATCH_SIZE=32
# Canonical Model 1 assist configuration. The multi-source runner defaults to this pair.
MODEL1_PROVIDER=transformers
MODEL1_MODEL=kakaocorp/kanana-nano-2.1b-instruct
MODEL1_API_KEY_ENV=
CATEGORY_ROOT_DEPTH=1
MIN_TERM_DOCUMENTS=3
MIN_TERM_DOCUMENT_RATIO=0.05
