MFDS_API_KEY=
FOODPOLIS_API_KEY=
FOODPOLIS_RETAIL_API_URL=
FOODPOLIS_API_KEY_PARAM=opapiAtkeyCn
MFDS_MAX_PAGES=
MFDS_CATALOG_PROFILES_PATH=
DEMAND_TAXONOMY_PATH=config/facet_taxonomy_v2_2.json
A_TAXONOMY_PATH=config/facet_taxonomy_v2_2.json
A_ALIAS_REGISTRY_PATH=config/model1_aliases_reviewed_v2.json
LABELING_LLM_FALLBACK_ENABLED=false
# Optional Model 2 LLM worker. Keep the model outside the A labeling image.
A_LLM_ENABLED=false
A_LLM_MODEL=qwen2.5:7b-instruct
A_LLM_ENDPOINT=http://ollama-model2:11434
A_LLM_TIMEOUT_SECONDS=300
A_LLM_BATCH_SIZE=5
A_LLM_MAX_ROWS=100
DEMAND_CONSTRAINT_RULES_PATH=config/demand_constraint_rules.json
# Optional A aliases: blank/missing file uses B only; invalid contents stop startup.
DEMAND_CONSTRAINT_ALIASES_PATH=config/model1_aliases_reviewed_v2.json
# Required B base expressions, always loaded; overlapping A expressions take priority.
DEMAND_CONSTRAINT_COMPAT_ALIASES_PATH=config/demand_constraint_aliases.json
SHARED_DATABASE_URL=
BACKEND_BASE_URL=
# Inject the shared AWS Parameter Store SecureString at deployment time.
BACKEND_INTERNAL_KEY=
# Backend -> AI 방향(판매자 수요 분석 API)의 내부 키. 같은 Parameter Store 에서 주입한다.
# 비워 두면 서버가 기동하지 않는다. 인증 없이 띄우려면 아래를 1 로 명시한다.
SELLER_ANALYSIS_INTERNAL_KEY=
SELLER_ANALYSIS_ALLOW_UNAUTHENTICATED=
BACKEND_HTTP_TIMEOUT_SECONDS=15
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
CLUSTER_MIN_PARTICIPANTS=5
E5_MODEL_PATH=
E5_MODEL_REVISION=
E5_BATCH_SIZE=32
# Recommended Mac/MPS execution profile for the small local model.
MODEL1_COMPACT_PROMPT=true
MODEL1_MAX_NEW_TOKENS=256
MODEL1_BATCH_SIZE=4
CATEGORY_ROOT_DEPTH=1
MIN_TERM_DOCUMENTS=3
MIN_TERM_DOCUMENT_RATIO=0.05
