    "positive_double_negative": [
      "아니면 안 돼",
      "아니면 안돼",
      "아니면 안 됩니다",
      "아니면 안 되",
      "아니면 구매하지 않"
    ],
    "positive_double_negative_regexes": [
      "(?:아니(?:고서|고서는|고선|면|라면)|아닌 건).*?(?:안\\s*(?:되|돼|됩|된)|선택하지 않|구매하지 않)",
      "(?:나오지\\s*않은|아닌)[^.!?]{0,24}제외[^.!?]{0,16}수밖에"
    ],
    "numeric_range_regex": "[0-9]+\\s*[~-]\\s*[0-9]+",
    "leading_preference_regex": "^(?:되면|여건이 되면)(?:\\s|,)",
    "polite_exclusion_regex": "(?:빼|제외|숨겨|숨기|가려|보이지 않).*?(?:주시면|주세요|주셨으면|해 주시면).*?(?:좋겠|좋을)",
    "split_soft_punctuation": true,
    "review_unmarked_explicit_facet": true,
    "prefer_over_value_only_must": true,
    "morphological_direct_request": true,
    "morphological_conditional_preference": true,
    "non_final_action_guard": true,
    "ambiguous_modality_regexes": [
      "(?:좋|괜찮|낫|나을)[^.!?]{0,16}(?:수도\\s*있|지\\s*않을까|지(?:도)?\\s*(?:모르|몰라)|것\\s*같기도)",
      "(?:문제|부담|지장)\\s*없을\\s*때"
    ],
    "semantic_exclusion_regexes": [
      "(?:뜨지\\s*않게\\s*걸러|빠져\\s*있으면)[^.!?]{0,16}좋",
      "(?:걷어내|걸러내|걸러|필터링|필터)",
      "걸러[^.!?]{0,16}안\\s*나오",
      "(?:받|선택|구매)[^.!?]{0,24}(?:수\\s*없|불가능)",
      "(?:주문|구매)[^.!?]{0,16}불가",
      "(?:거부|차단)",
      "(?:보여\\s*주지|보여주지|포함하지)[^.!?]{0,12}(?:말|마)",
      "(?:선택지|선택\\s*대상)[^.!?]{0,20}(?:들어올|될)\\s*수\\s*없"
    ],
    "positive_double_negative_priority_regexes": [
      "아닌[^.!?]{0,32}(?:제외하지\\s*않을\\s*수\\s*없|뺄\\s*수밖에\\s*없)",
      "(?:되어\\s*)?있지\\s*않은[^.!?]{0,32}제외할\\s*수밖에",
      "아닌[^.!?]{0,24}못\\s*하겠[^.!?]{0,24}(?:꼭|필수|이어야|여야)"
    ],
    "local_relation_scope": true,
    "reported_context_guard": true,
    "ranking_preference_regexes": [
